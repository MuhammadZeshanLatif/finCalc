Options -MultiViews -Indexes
RewriteEngine On
RewriteBase /

# Prerender folders (e.g. /deposit/index.html): serve at /deposit without /deposit/ redirect loop
DirectorySlash Off

# ── Verification & crawler files: always real files, never SPA index.html ──
RewriteRule ^(ads\.txt|app-ads\.txt|robots\.txt|sitemap\.xml|sitemap\.xsl|llms\.txt|llm\.txt|manifest\.webmanifest|google[a-z0-9]+\.html)$ - [L]

# Consolidate host to avoid duplicate www/non-www indexing
RewriteCond %{HTTP_HOST} ^www\.financcalculator\.ru$ [NC]
RewriteRule ^ https://financcalculator.ru%{REQUEST_URI} [R=301,L]

# Legacy URL cleanup (avoid soft-404/noindex crawl waste)
RewriteRule ^ru/loanearly/?$ /ru/loan [R=301,L]
RewriteRule ^ru/autoloan/?$ /ru/loan [R=301,L]
RewriteRule ^loanearly/?$ /loan [R=301,L]
RewriteRule ^autoloan/?$ /loan [R=301,L]

# Internally serve prerender HTML (no external redirect to trailing-slash URL)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Canonical: strip trailing slash (except site root)
RewriteCond %{REQUEST_URI} .+/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# SPA fallback for routes without prerender folder
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# ── Crawlers, AI bots, Google AdSense: allow full access (no bot blocking) ──
<IfModule mod_headers.c>
  # Index everything — AdSense / Google / AI crawlers must read pages and ads.txt
  Header always set X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"

  <FilesMatch "^(ads|app-ads)\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set X-Robots-Tag "all"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  <FilesMatch "^(robots|llms?)\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  <FilesMatch "^sitemap\.(xml|xsl)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
