# Canonical site URL (no trailing slash)
VITE_SITE_URL=https://financcalculators.com

# Copy your exact Grow site ID from the Grow Publisher Portal. Required for Journey review.
# VITE_GROW_SITE_ID=

# Optional Google Analytics measurement ID. Connect the GA4 property in the Mediavine application dashboard.
# VITE_GA4_ID=

# Add only after Journey approves the site and supplies its script slug.
# VITE_MEDIAVINE_SITE_SLUG=

# Optional: full URL for social previews (overrides default /og-image.webp)
# VITE_OG_IMAGE_URL=https://financcalculators.com/custom-share.png

# Optional: legal / brand name shown in JSON-LD Organization
# VITE_ORG_NAME=FinanceCalculator

# Optional: contact email for Organization contactPoint in JSON-LD
# VITE_CONTACT_EMAIL=hello@example.com

# Optional: Twitter/X handles (no @) — defaults to fincalculat if unset
# VITE_TWITTER_SITE=fincalculat
# VITE_TWITTER_CREATOR=fincalculat

# Optional: extra sameAs URLs (comma-separated); X + Instagram are included by default in code
# VITE_ORG_SAME_AS=https://facebook.com/yourpage,https://youtube.com/@yourchannel

# Optional: ExchangeRate-API v6 key — 160+ currencies & frequent updates (https://www.exchangerate-api.com/)
# Without it, live rates use the free Frankfurter API (ECB data, many majors, no key, browser-side).
# VITE_EXCHANGE_RATE_API_KEY=
