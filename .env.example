# Canonical site URL (no trailing slash)
VITE_SITE_URL=https://fincalc-multipurpose.pro

# Optional: full URL to a 1200×630 PNG/JPG for social previews (overrides default /og-image.svg)
# VITE_OG_IMAGE_URL=https://fincalc-multipurpose.pro/og-share.png

# Optional: legal / brand name shown in JSON-LD Organization
# VITE_ORG_NAME=FinCalc

# Optional: contact email for Organization contactPoint in JSON-LD
# VITE_CONTACT_EMAIL=hello@example.com

# Optional: Twitter/X handles (no @)
# VITE_TWITTER_SITE=fincalc
# VITE_TWITTER_CREATOR=fincalc

# Optional: comma-separated social profile URLs for Organization sameAs
# VITE_ORG_SAME_AS=https://twitter.com/fincalc,https://facebook.com/yourpage

# Optional: ExchangeRate-API v6 key — 160+ currencies & frequent updates (https://www.exchangerate-api.com/)
# Without it, live rates use the free Frankfurter API (ECB data, many majors, no key, browser-side).
# VITE_EXCHANGE_RATE_API_KEY=
