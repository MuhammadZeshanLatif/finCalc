# Canonical site URL (no trailing slash)
VITE_SITE_URL=https://financcalculator.ru

# Optional: full URL for social previews (overrides default /preview-image.webp)
# VITE_OG_IMAGE_URL=https://financcalculator.ru/custom-share.png

# Optional: legal / brand name shown in JSON-LD Organization
# VITE_ORG_NAME=FinanceCalculator

# Optional: contact email for Organization contactPoint in JSON-LD
# VITE_CONTACT_EMAIL=hello@example.com

# Optional: Twitter/X handles (no @) — defaults to fincalculat if unset
# VITE_TWITTER_SITE=fincalculat
# VITE_TWITTER_CREATOR=fincalculat

# Optional: extra sameAs URLs (comma-separated); X + Instagram are included by default in code
# VITE_ORG_SAME_AS=https://facebook.com/yourpage,https://youtube.com/@yourchannel

# Optional: ExchangeRate-API v6 key — 160+ currencies & frequent updates (https://www.exchangerate-api.com/)
# Without it, live rates use the free Frankfurter API (ECB data, many majors, no key, browser-side).
# VITE_EXCHANGE_RATE_API_KEY=

# Vercel → Project → Settings → Environment Variables (set for Production and Preview):
#   Build / client: VITE_SITE_URL, VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
#   Server /api routes: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ADMIN_EMAIL, GEMINI_API_KEY
#   Optional: GEMINI_MODEL, OPENAI_API_KEY, OPENAI_MODEL, VITE_ADMIN_* (local-only convenience)

# Supabase (client)
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Supabase (server / Vercel API only)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ADMIN_EMAIL=admin@example.com

# Optional: auto-fill BlogStudio admin login on local machine only
# VITE_ADMIN_EMAIL=admin@example.com
# VITE_ADMIN_PASSWORD=

# Blog generation API key (Gemini preferred; OpenAI fallback)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
